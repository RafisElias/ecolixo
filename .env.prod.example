# Copie para .env.prod (não versionado) e troque TODOS os valores.
# Uso: docker compose -f docker-compose.prod.yml --env-file .env.prod up -d --build

# Domínio público apontando para o IP da VPS (o Caddy emite o certificado HTTPS).
DOMAIN=ecolixo.example.com

# Gere com: openssl rand -hex 32
POSTGRES_PASSWORD=troque-por-uma-senha-longa
SECRET_KEY=troque-por-openssl-rand-hex-32

# Código exigido para cadastrar gestores. Vazio desativa o cadastro de gestores.
GESTOR_REGISTRATION_CODE=troque-este-codigo

ACCESS_TOKEN_EXPIRE_MINUTES=60
MAX_UPLOAD_MB=5
